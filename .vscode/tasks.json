{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build all",
      "type": "shell",
      "isBackground": true,
      "command": ". esp-idf.fish && cmake --build build --parallel"
    },
    {
      "label": "Build FirmwareDocs",
      "type": "shell",
      "isBackground": true,
      "command": ". esp-idf.fish && cmake --build build --parallel --target FirmwareDocs"
    },
    {
      "label": "Build FirmwareFormat",
      "type": "shell",
      "isBackground": true,
      "command": ". esp-idf.fish && cmake --build build --parallel --target FirmwareFormat"
    },
    {
      "label": "Build FirmwareLst",
      "type": "shell",
      "isBackground": true,
      "command": ". esp-idf.fish && cmake --build build --parallel --target FirmwareLst"
    },
    {
      "label": "Clean",
      "type": "shell",
      "isBackground": true,
      "command": "rm -rf build && rm -rf managed_components && rm -rf dependencies.lock && rm -rf sdkconfig && rm -rf sdkconfig.old",
    },
    {
      "label": "Config Debug",
      "type": "shell",
      "isBackground": true,
      "command": ". esp-idf.fish && cmake --preset \"Debug\""
    },
    {
      "label": "Config Debug JTAG",
      "type": "shell",
      "isBackground": true,
      "command": ". esp-idf.fish && cmake --preset \"Debug JTAG\""
    },
    {
      "label": "Config Release",
      "type": "shell",
      "isBackground": true,
      "command": ". esp-idf.fish && cmake --preset \"Release\""
    },
    {
      "label": "Config Release JTAG",
      "type": "shell",
      "isBackground": true,
      "command": ". esp-idf.fish && cmake --preset \"Release JTAG\""
    },
    {
      "label": "Config Tests",
      "type": "shell",
      "isBackground": true,
      "command": ". esp-idf.fish && cmake --preset \"Tests\""
    },
    {
      "label": "Run act Tests",
      "type": "shell",
      "isBackground": true,
      "command": "act -j tests"
    },
    {
      "label": "Run OpenOCD",
      "type": "shell",
      "isBackground": true,
      "options": {
        "cwd": "${userHome}/.espressif/tools/openocd-esp32/v0.12.0-esp32-20260703/openocd-esp32"
      },
      "command": "bin/openocd -f board/esp32s3-builtin.cfg",
      "problemMatcher": {
        "owner": "openocd",
        "pattern": {
          "regexp": "a^"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Open On-Chip Debugger\\b",
          "endsPattern": "^.*Listening on port 3333 for gdb connections.*$"
        }
      }
    },
    {
      "label": "Run esp-emu",
      "type": "shell",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/build/_deps/esp-emulator-src"
      },
      "command": "./esp-emu --chip esp32s3 --firmware ${workspaceFolder}/build/merged-binary.bin --elf ${workspaceFolder}/build/Firmware.elf --gdb 3333 --gdb-halt",
      "problemMatcher": {
        "owner": "esp-emu",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*$",
          "endsPattern": "^.*GDB stub listening on :3333.*$"
        }
      }
    },
    {
      "label": "Run Python http.server",
      "type": "shell",
      "isBackground": true,
      "command": "python -m http.server --directory ${workspaceFolder}/build/docs/html --bind 127.0.0.1"
    },
    {
      "label": "Run Tests",
      "type": "shell",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/build/_deps/esp-emulator-src"
      },
      "command": "./esp-emu --chip esp32s3 --firmware ${workspaceFolder}/build/merged-binary.bin --elf ${workspaceFolder}/build/Firmware.elf --exit-on TEST_RESULT:"
    },
  ]
}