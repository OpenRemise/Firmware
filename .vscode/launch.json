{
  "version": "0.2.0",
  "configurations": [
    // https://docs.espressif.com/projects/vscode-esp-idf-extension/en/latest/debugproject.html#other-extensions-debug-configuration
    {
      "name": "Debug Firmware",
      "type": "gdb",
      "request": "attach",
      "target": "extended-remote :3333",
      "executable": "${workspaceFolder}/build/Firmware.elf",
      "gdbpath": "${userHome}/.espressif/tools/xtensa-esp-elf-gdb/17.1_20260402/xtensa-esp-elf-gdb/bin/xtensa-esp32s3-elf-gdb",
      "cwd": "${workspaceFolder}",
      "autorun": [
        "set pagination off",
        "mon reset halt",
        "maintenance flush register-cache",
        "thb app_main"
      ],
      "preLaunchTask": "Run OpenOCD",
    },
    {
      "name": "Debug FirmwareTests",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/Firmware.elf",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "${userHome}/.espressif/tools/xtensa-esp-elf-gdb/17.1_20260402/xtensa-esp-elf-gdb/bin/xtensa-esp32s3-elf-gdb",
      "miDebuggerServerAddress": "localhost:3333",
      "setupCommands": [
        {
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Run esp-emu"
    }
  ]
}